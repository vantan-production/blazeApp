# このファイルをコピーして .env.local を作成する: cp .env.example .env.local
# .env.local はgitignore対象なので、実際の値は各自のローカルにのみ置く。

# back APIのベースURL。front/lib/apiClient.ts, front/lib/auth.ts が参照する。
# docker-compose経由で起動する場合はdocker-compose.yml側の値が使われる。
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# 画像を置くS3バケット名（backと同じ値）。front/next.config.ts が next/image の許可ホストに使う。
# ビルド時に読まれるため、Vercelの環境変数にも設定すること。未設定だとS3画像の最適化が拒否される。
AWS_S3_BUCKET=

# 活動ページのスケジュールに表示するカレンダーの公開ICS URL。front/lib/schedule.ts が参照する（1時間ごとに再取得）。
# Googleカレンダー: 設定 >「カレンダーの統合」>「iCal 形式の公開 URL」（非公開のままなら「iCal 形式の非公開 URL」）
# iCloudカレンダー: カレンダーの共有 >「公開カレンダー」をオンにして表示される webcal:// のURL（そのまま貼ってよい）
# 未設定なら、活動日時の曜日に印を付けるだけの表示になる。Vercelの環境変数にも設定すること。
SCHEDULE_ICAL_URL=
